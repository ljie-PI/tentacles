# 复制为 .env 后填写。配置文件里用 ${VAR} 引用这些变量；
# .env 中的值不会覆盖已经存在的环境变量。
#
# 注意：TENTACLES_CONFIG（配置文件路径）和 TENTACLES_JSON=1（CLI 默认输出 JSON）
# 决定了去哪里找配置和 .env，因此只能设置为真正的环境变量，写在 .env 里不会生效。

# 按需填写；留空仍可使用 RSS，不会自动调用模型。
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# 可选 IMAP 邮箱；源默认 enabled: false。不要填写日常登录密码（启用2FA时使用应用专用密码）。
IMAP_HOST=imap.gmail.com
IMAP_USERNAME=
IMAP_PASSWORD=

# 可选：tentacles serve 的 Bearer token（仅 ASCII、无空白）。对外监听请务必设置。
TENTACLES_SERVER_TOKEN=
